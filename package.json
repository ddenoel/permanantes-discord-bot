{
	"name": "permanantes_discord",
	"version": "1.0.0",
	"description": "Discord bot for Troupe Permanantes",
	"main": "dist/index.js",
	"scripts": {
		"build": "tsc",
		"start": "node dist/index.js",
		"dev": "ts-node-dev --respawn --transpile-only src/index.ts",
		"deploy-commands": "ts-node src/discord/deploy-commands.ts",
		"lint": "eslint . --ext .ts",
		"lint:fix": "eslint . --ext .ts --fix",
		"format": "prettier --write \"src/**/*.ts\""
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@types/node-schedule": "^2.1.7",
		"axios": "^1.8.3",
		"date-fns": "^4.1.0",
		"discord.js": "^14.18.0",
		"dotenv": "^16.4.7",
		"express": "^4.21.2",
		"node-schedule": "^2.1.1"
	},
	"devDependencies": {
		"@types/date-fns": "^2.6.3",
		"@types/express": "^5.0.0",
		"@types/node": "^22.13.10",
		"@typescript-eslint/eslint-plugin": "^8.26.1",
		"@typescript-eslint/parser": "^8.26.1",
		"eslint": "^9.22.0",
		"eslint-config-prettier": "^10.1.1",
		"eslint-plugin-prettier": "^5.2.3",
		"prettier": "^3.5.3",
		"ts-node": "^10.9.2",
		"ts-node-dev": "^2.0.0",
		"typescript": "^5.8.2"
	}
}
